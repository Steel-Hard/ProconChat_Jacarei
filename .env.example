# Idade maxima (em segundos) de uma mensagem para ainda ser processada; mensagens mais
# antigas (ex.: backfill de historico apos parear um numero novo) sao ignoradas com
# reason: "stale_message". 0 ou valor invalido = sem limite de idade.
EVOLUTION_MESSAGE_MAX_AGE_SECONDS=300

LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_MS=20000
