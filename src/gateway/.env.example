# ===================================================================
# EVOLUTION API - CONFIGURAÇÃO DE AMBIENTE
# ===================================================================
# IMPORTANTE: Altere todas as variáveis marcadas com "change_me_in_production"
# em ambientes de produção. Nunca use valores padrão em produção!
# ===================================================================

# CREDENCIAIS POSTGRES
# Usuário padrão (alterar em produção)
POSTGRES_USER=evolution

# Senha do Postgres (MUDE EM PRODUÇÃO!)
POSTGRES_PASSWORD=change_me_in_production

# Porta do Postgres (padrão: 5432)
POSTGRES_PORT=5432

# CREDENCIAIS REDIS
# Senha do Redis (MUDE EM PRODUÇÃO!)
REDIS_PASSWORD=change_me_in_production

# Porta do Redis (padrão: 6379)
REDIS_PORT=6379

# EVOLUTION API
# Porta da API (padrão: 8080)
API_PORT=8080

# Chave de autenticação da API (MUDE EM PRODUÇÃO!)
AUTHENTICATION_API_KEY=sua-chave-secreta-aqui

# ===================================================================
# CONFIGURAÇÕES REDIS (Evolution API)
# ===================================================================
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ===================================================================
# CONFIGURAÇÕES POSTGRES (Evolution API)
# ===================================================================
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/evolution?schema=public'
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Dados a serem salvos no banco de dados
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
