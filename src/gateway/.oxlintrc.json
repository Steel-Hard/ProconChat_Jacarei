{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "oxc"],
    "categories": {
        "correctness": "error",
        "suspicious": "error"
    },
    "rules": {
        "typescript/no-explicit-any": "error"
    },
    "ignorePatterns": ["dist", "node_modules"],
    "env": {
        "builtin": true
    }
}
